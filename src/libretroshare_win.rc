#include <winver.h>
#include "retroshare/rsversion.h"

#define STRINGIZER(version) #version
#define VERSION_STRING(major,minor,mini,patch,extra,librs_git_hash) STRINGIZER(major) "." STRINGIZER(minor) "." STRINGIZER(mini) "." STRINGIZER(patch) STRINGIZER(extra) " (" STRINGIZER(librs_git_hash) ")"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     RS_MAJOR_VERSION,RS_MINOR_VERSION,RS_MINI_VERSION,RS_PATCH_VERSION
PRODUCTVERSION  RS_MAJOR_VERSION,RS_MINOR_VERSION,RS_MINI_VERSION,RS_PATCH_VERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName", ""
            VALUE "FileDescription", "libretroshare"
            VALUE "FileVersion", VERSION_STRING(RS_MAJOR_VERSION, RS_MINOR_VERSION, RS_MINI_VERSION, RS_PATCH_VERSION, RS_EXTRA_VERSION, RS_LIB_GIT_HASH)
            VALUE "InternalName", "libretroshare"
            VALUE "OriginalFilename", "retroshare.dll"
            VALUE "ProductName", "RetroShare"
            VALUE "ProductVersion", VERSION_STRING(RS_MAJOR_VERSION, RS_MINOR_VERSION, RS_MINI_VERSION, RS_PATCH_VERSION, RS_EXTRA_VERSION, RS_LIB_GIT_HASH)
            VALUE "LegalCopyright", ""
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0809, 1200
    END
END
