#ifndef RS_RETROSHARE_RSVERSION_H
#define RS_RETROSHARE_RSVERSION_H

${DEFINE_RS_VERSION}
${DEFINE_RS_VERSION_FULL}
${DEFINE_RS_VERSION_PUBLIC}
${DEFINE_RS_VERSION_MAJOR}
${DEFINE_RS_VERSION_MINOR}
${DEFINE_RS_VERSION_PATCH}
${DEFINE_RS_VERSION_TWEAK}
${DEFINE_RS_VERSION_NUMERIC}

#define RS_VERSION_ATLEAST(MAJOR, MINOR, PATCH, TWEAK) \
	(${numeric2} >= ((MAJOR) << 24 | (MINOR) << 16 | (PATCH) << 8 | (TWEAK) << 0))


// deprecated
#ifdef RS_DEPRECATED_VERSION_MACROS
#define RS_MAJOR_VERSION RS_VERSION_MAJOR
#define RS_MINOR_VERSION RS_VERSION_MINOR
#define RS_MINI_VERSION RS_VERSION_PATCH
#define RS_EXTRA_VERSION "-x"
#define RS_VERSION_AT_LEAST(a,b,c) RS_VERSION_ATLEAST(a,b,c,0)
#define RS_HUMAN_READABLE_VERSION RS_VERSION_FULL
#define RS_SHARED_VERSION RS_VERSION_PUBLIC
#endif

#endif // RS_RETROSHARE_RSVERSION_H
