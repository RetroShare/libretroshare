cmake_minimum_required(VERSION 3.0...4.4)

@PACKAGE_INIT@

list(APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR}/Modules)

include(CMakeFindDependencyMacro)
find_dependency(RapidJSON)
include(${CMAKE_CURRENT_LIST_DIR}/Modules/FixRapidJSONTarget.cmake)

@PACKAGE_DEPENDENCIES@

include(IncludeNrsMacro)
include_nrs(
	"${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME_LOWER@-targets.cmake"
	NO_RETURN_SCOPE # targets.cmake might call `return()` in `find_dependency()`
)

include(FixRnpDeps)

set(${PACKAGE_FIND_NAME}_SAM3_FOUND @RS_USE_I2P_SAM3@)

check_required_components("${PACKAGE_FIND_NAME}")
